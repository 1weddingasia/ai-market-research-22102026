# ============================================================
# AI SYNTHETIC MARKET RESEARCH PLATFORM - Backend Environment
# ============================================================
# Copy file này thành .env và điền đầy đủ giá trị

# --- Cloudflare R2 (S3-compatible) ---
# Lấy từ: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=personas-vietnam
R2_FILE_KEY=personas_vn_1m.parquet

# --- OpenAI ---
OPENAI_API_KEY=sk-your_openai_api_key

# --- SePay ---
# Lấy từ: sepay.vn → Tài khoản → API Settings
SEPAY_API_TOKEN=your_sepay_api_token
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
# Thông tin tài khoản ngân hàng nhận tiền
BANK_ACCOUNT_NUMBER=your_bank_account_number
BANK_NAME=Vietcombank
BANK_SHORT_NAME=VCB
# Tên chủ tài khoản (hiển thị trên QR)
ACCOUNT_NAME=CONG TY ABC

# --- Resend (Email notification) ---
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=insight@1booking.asia
# Trong môi trường dev, override bằng email test của Resend:
# EMAIL_FROM=onboarding@resend.dev

# --- App ---
FRONTEND_URL=https://your-app.vercel.app
# Để trống khi local, điền domain khi deploy
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Database (Supabase PostgreSQL for Production / SQLite for Local) ---
# Connect via Supabase shared pooler (IPv4-compatible for Render):
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API Credentials
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Server ---
PORT=8000
ENVIRONMENT=development
# Đổi thành production khi deploy lên Render
PYTHONUTF8=1

# ─── DEV / LOCAL MODE ────────────────────────────────────────────
# Đặt đường dẫn file Parquet nếu muốn test mà KHÔNG cần upload R2
# VD: C:/Data/personas_vn_1m.parquet
# Nếu set biến này, R2 hoàn toàn bị bỏ qua.
LOCAL_PARQUET_PATH=

# ─── TELEGRAM BOT NOTIFICATIONS & LOOKUP ─────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_to_receive_alerts
